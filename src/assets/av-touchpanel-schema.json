{
    "$schema": "https://json-schema.org/draft-07/schema",
    "title": "av-touchpanel-schema",
    "type": "object",
    "properties": {
        "version": {
            "type": "integer",
            "description": "av-touchpanel-schema version",
            "default": 0,
            "enum": [0]
        },
        "client": {
            "type": "object",
            "description": "settings for the web ui, the client",
            "required": ["page_id"],
            "properties": {
                "page_id": {
                    "type": "string",
                    "default": ""
                },
                "theme": {
                    "type": "string",
                    "default": "auto",
                    "enum": ["auto", "light", "dark", "black"]
                },
                "scale": {
                    "type": "number",
                    "description": "overall scale of ui",
                    "default": 1.5,
                    "minimum": 0.5,
                    "maximum": 8.0,
                    "multipleOf": 0.1
                },
                "scale_small": {
                    "type": "number",
                    "description": "overall scale of ui on devices with width less than 550px",
                    "default": 1.0,
                    "minimum": 0.5,
                    "maximum": 8.0,
                    "multipleOf": 0.1
                },
                "rotate": {
                    "type": "integer",
                    "description": "rotate ui clockwise",
                    "default": 0,
                    "enum": [0, 90, 180, 270]
                },
                "blackout_timeout_min": {
                    "type": "integer",
                    "description": "length of time, in minutes, with no activity before screen blackout",
                    "minimum": 1,
                    "default": 5
                }
            }
        },
        "backend": {
            "type": "object",
            "description": "backend server / processor / core",
            "properties": {
                "host": {
                    "type": "string",
                    "description": "hostname or ip address",
                    "format": "ipv4",
                    "default": "172.22.0.1"
                },
                "type": {
                    "type": "string",
                    "description": "backend server / processor / core type",
                    "default": "offline",
                    "enum": ["offline", "crestron", "qsys", "websocket"]
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "crestron"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "ipid": {
                                "type": "string",
                                "default": "0x03"
                            },
                            "roomid": {
                                "type": "string",
                                "default": "1"
                            },
                            "token": {
                                "type": "string",
                                "default": "longtokenfromvc4"
                            },
                            "config_path": {
                                "type": "string",
                                "description": "client -> server, config path. VC4 = '\\\\XPanel\\\\tp1.json' or '\\\\XPanel\\\\tp1' or '\\\\User\\\\tp1.json' or '\\\\Html\\\\tp1.json'",
                                "default": "\\\\XPanel\\\\tp1"
                            },
                            "out_string_config_path": {
                                "type": "string",
                                "description": "client -> server, key to send the config_path to",
                                "default": ""
                            },
                            "out_string_saved_config": {
                                "type": "string",
                                "description": "client -> server, json string of the newly saved config",
                                "default": ""
                            },
                            "in_string_load_config": {
                                "type": "string",
                                "description": "server -> client, name of json file to load",
                                "default": ""
                            }
                        },
                        "required": ["ipid", "roomid", "token"]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "qsys"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "port": {
                                "type": "string",
                                "default": "5000"
                            }
                        },
                        "required": ["port"]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "websocket"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "port": {
                                "type": "string",
                                "default": "5000"
                            }
                        },
                        "required": ["port"]
                    }
                }
            ]
        },
        "page_list": {
            "type": "array",
            "description": "List of all pages",
            "required": ["page_id"],
            "properties": {
                "page_id": {
                    "type": "string",
                    "default": ""
                },
                "page_type": {
                    "type": "string",
                    "default": "rows",
                    "enum": ["rows", "matrix"]
                },
                "title": {
                    "type": "string",
                    "default": ""
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "page_type": {
                                "const": "rows"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "rows": {
                                "type": "array",
                                "properties": {
                                    "widgets": {
                                        "type": "array",
                                        "properties": {
                                            "widget_type": {
                                                "type": "string",
                                                "default": "text",
                                                "enum": [
                                                    "text",
                                                    "button",
                                                    "spacer",
                                                    "slider",
                                                    "page"
                                                ]
                                            },
                                            "grow": {
                                                "type": "integer",
                                                "default": 1,
                                                "minimum": 0
                                            }
                                        },
                                        "allOf": [
                                            {
                                                "if": {
                                                    "properties": {
                                                        "widget_type": {
                                                            "const": "text"
                                                        }
                                                    }
                                                },
                                                "then": {
                                                    "properties": {
                                                        "text": {
                                                            "type": "string",
                                                            "default": "text"
                                                        },
                                                        "id_string_set": {
                                                            "type": "string",
                                                            "default": ""
                                                        },
                                                        "id_boolean_hide": {
                                                            "type": "string",
                                                            "default": ""
                                                        }
                                                    }
                                                }
                                            },
                                            {
                                                "if": {
                                                    "properties": {
                                                        "widget_type": {
                                                            "const": "button"
                                                        }
                                                    }
                                                },
                                                "then": {
                                                    "properties": {
                                                        "text": {
                                                            "type": "string",
                                                            "default": "text"
                                                        },
                                                        "id_boolean_press": {
                                                            "type": "string",
                                                            "default": ""
                                                        },
                                                        "id_boolean_disable": {
                                                            "type": "string",
                                                            "default": ""
                                                        },
                                                        "id_boolean_hide": {
                                                            "type": "string",
                                                            "default": ""
                                                        },
                                                        "id_boolean_active": {
                                                            "type": "string",
                                                            "default": ""
                                                        },
                                                        "active_text": {
                                                            "type": "string",
                                                            "description": "text to display when active",
                                                            "default": ""
                                                        },
                                                        "active_color": {
                                                            "type": "string",
                                                            "default": "default",
                                                            "enum": [
                                                                "default",
                                                                "red",
                                                                "orange",
                                                                "yellow",
                                                                "green",
                                                                "cyan",
                                                                "blue",
                                                                "purple",
                                                                "pink",
                                                                "custom"
                                                            ]
                                                        },
                                                        "active_custom_color_hex": {
                                                            "type": "string",
                                                            "pattern": "^#(?:[A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$",
                                                            "default": "#FFFFFF"
                                                        }
                                                    }
                                                }
                                            },
                                            {
                                                "if": {
                                                    "properties": {
                                                        "widget_type": {
                                                            "const": "slider"
                                                        }
                                                    }
                                                },
                                                "then": {
                                                    "properties": {
                                                        "text": {
                                                            "type": "string",
                                                            "default": "text"
                                                        },
                                                        "value": {
                                                            "type": "integer",
                                                            "default": "50"
                                                        },
                                                        "max": {
                                                            "type": "integer",
                                                            "default": "100"
                                                        },
                                                        "min": {
                                                            "type": "integer",
                                                            "default": "0"
                                                        },
                                                        "step": {
                                                            "type": "integer",
                                                            "default": "5"
                                                        },
                                                        "units": {
                                                            "type": "string",
                                                            "default": ""
                                                        },
                                                        "signed": {
                                                            "type": "string",
                                                            "default": "false",
                                                            "enum": ["true", "false"]
                                                        },
                                                        "id_integer_value": {
                                                            "type": "string",
                                                            "description": "value of the silder, fb and changes",
                                                            "default": ""
                                                        },
                                                        "id_boolean_press": {
                                                            "type": "string",
                                                            "default": ""
                                                        },
                                                        "id_boolean_disable": {
                                                            "type": "string",
                                                            "default": ""
                                                        },
                                                        "id_boolean_hide": {
                                                            "type": "string",
                                                            "default": ""
                                                        },
                                                        "id_boolean_active": {
                                                            "type": "string",
                                                            "default": ""
                                                        },
                                                        "active_text": {
                                                            "type": "string",
                                                            "description": "text to display when active",
                                                            "default": ""
                                                        },
                                                        "active_color": {
                                                            "type": "string",
                                                            "default": "default",
                                                            "enum": [
                                                                "default",
                                                                "red",
                                                                "orange",
                                                                "yellow",
                                                                "green",
                                                                "cyan",
                                                                "blue",
                                                                "purple",
                                                                "pink",
                                                                "custom"
                                                            ]
                                                        },
                                                        "active_custom_color_hex": {
                                                            "type": "string",
                                                            "pattern": "^#(?:[A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$",
                                                            "default": "#FFFFFF"
                                                        }
                                                    }
                                                }
                                            },
                                            {
                                                "if": {
                                                    "properties": {
                                                        "widget_type": {
                                                            "const": "page"
                                                        }
                                                    }
                                                },
                                                "then": {
                                                    "properties": {
                                                        "page_id": {
                                                            "type": "string",
                                                            "default": "text"
                                                        }
                                                    }
                                                }
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "page_type": {
                                "const": "matrix"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "input_title": {
                                "type": "string",
                                "default": "Select Source"
                            },
                            "output_title": {
                                "type": "string",
                                "default": "Then Destination"
                            },
                            "input_columns": {
                                "type": "integer",
                                "default": 1
                            },
                            "output_columns": {
                                "type": "integer",
                                "default": 1
                            },
                            "input_active_color": {
                                "type": "string",
                                "default": "default",
                                "enum": [
                                    "default",
                                    "red",
                                    "orange",
                                    "yellow",
                                    "green",
                                    "cyan",
                                    "blue",
                                    "purple",
                                    "pink",
                                    "custom"
                                ]
                            },
                            "inputs": {
                                "type": "array",
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "default": ""
                                    },
                                    "id_boolean_press": {
                                        "type": "string",
                                        "default": ""
                                    }
                                }
                            },
                            "outputs": {
                                "type": "array",
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "default": ""
                                    },
                                    "id_boolean_press": {
                                        "type": "string",
                                        "default": ""
                                    },
                                    "id_integer_input_fb": {
                                        "type": "string",
                                        "description": "input index from inputs array. starts at 1",
                                        "default": ""
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        }
    },
    "required": ["version"]
}
