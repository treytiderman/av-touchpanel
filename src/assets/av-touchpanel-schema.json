{
    "$schema": "https://json-schema.org/draft-07/schema",
    "title": "av-touchpanel-schema",
    "type": "object",
    "properties": {
        "version": {
            "type": "integer",
            "description": "av-touchpanel-schema version",
            "default": 0,
            "enum": [0]
        },
        "client": {
            "type": "object",
            "description": "settings for the web ui, the client",
            "required": ["page_id_active"],
            "properties": {
                "page_id_active": {
                    "type": "string",
                    "default": ""
                },
                "theme": {
                    "type": "string",
                    "default": "auto",
                    "enum": ["auto", "light", "dark", "black"]
                },
                "scale": {
                    "type": "number",
                    "description": "overall scale of ui",
                    "default": 1.5,
                    "minimum": 0.5,
                    "maximum": 8.0,
                    "multipleOf": 0.1
                },
                "scale_small": {
                    "type": "number",
                    "description": "overall scale of ui on devices with width less than 550px",
                    "default": 1.0,
                    "minimum": 0.5,
                    "maximum": 8.0,
                    "multipleOf": 0.1
                },
                "rotate": {
                    "type": "integer",
                    "description": "rotate ui clockwise",
                    "default": 0,
                    "enum": [0, 90, 180, 270]
                },
                "blackout_timeout_min": {
                    "type": "integer",
                    "description": "length of time, in minutes, with no activity before screen blackout",
                    "minimum": 1,
                    "default": 5
                }
            }
        },
        "server": {
            "type": "object",
            "description": "backend computer or processor",
            "properties": {
                "host": {
                    "type": "string",
                    "description": "hostname or ip address",
                    "format": "ipv4",
                    "default": "172.22.0.1"
                },
                "backend": {
                    "type": "string",
                    "description": "backend server or processor or core",
                    "default": "offline",
                    "enum": [
                        "offline",
                        "crestron",
                        "qsys",
                        "websocket",
                        "redis"
                    ]
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "backend": {
                                "const": "crestron"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "ipid": {
                                "type": "string",
                                "default": "0x03"
                            },
                            "roomid": {
                                "type": "string",
                                "default": "1"
                            },
                            "token": {
                                "type": "string",
                                "default": "longtokenfromvc4"
                            }
                        },
                        "required": ["ipid", "roomid", "token"]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "backend": {
                                "const": "qsys"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "port": {
                                "type": "string",
                                "default": "5000"
                            }
                        },
                        "required": ["port"]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "backend": {
                                "const": "websocket"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "port": {
                                "type": "string",
                                "default": "5000"
                            }
                        },
                        "required": ["port"]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "backend": {
                                "const": "redis"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "prefix": {
                                "type": "string",
                                "default": "av-tp"
                            }
                        },
                        "required": ["prefix"]
                    }
                }
            ]
        },
        "page_list": {
            "type": "array",
            "description": "List of all pages",
            "required": ["page_id"],
            "properties": {
                "page_id": {
                    "type": "string",
                    "default": ""
                },
                "page_type": {
                    "type": "string",
                    "default": "rows",
                    "enum": ["rows", "matrix"]
                },
                "title": {
                    "type": "string",
                    "default": ""
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "page_type": {
                                "const": "rows"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "rows": {
                                "type": "array",
                                "properties": {
                                    "widgets": {
                                        "type": "array",
                                        "properties": {
                                            "control_id": {
                                                "type": "string",
                                                "default": ""
                                            },
                                            "grow": {
                                                "type": "integer",
                                                "default": 1,
                                                "minimum": 0
                                            },
                                            "widget_type": {
                                                "type": "string",
                                                "default": "text",
                                                "enum": [
                                                    "text",
                                                    "button",
                                                    "spacer",
                                                    "slider",
                                                    "page"
                                                ]
                                            }
                                        },
                                        "allOf": [
                                            {
                                                "if": {
                                                    "properties": {
                                                        "widget_type": {
                                                            "const": "text"
                                                        }
                                                    }
                                                },
                                                "then": {
                                                    "properties": {
                                                        "text": {
                                                            "type": "string",
                                                            "default": "text"
                                                        },
                                                        "control_id_text": {
                                                            "type": "string",
                                                            "default": ""
                                                        },
                                                        "control_id_hidden": {
                                                            "type": "string",
                                                            "default": ""
                                                        }
                                                    }
                                                }
                                            },
                                            {
                                                "if": {
                                                    "properties": {
                                                        "widget_type": {
                                                            "const": "button"
                                                        }
                                                    }
                                                },
                                                "then": {
                                                    "properties": {
                                                        "text": {
                                                            "type": "string",
                                                            "default": "text"
                                                        },
                                                        "control_id_active": {
                                                            "type": "string",
                                                            "default": ""
                                                        },
                                                        "active_text": {
                                                            "type": "string",
                                                            "default": ""
                                                        },
                                                        "active_color_hex": {
                                                            "type": "string",
                                                            "pattern": "^#(?:[A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$",
                                                            "default": ""
                                                        },
                                                        "active_background_hex": {
                                                            "type": "string",
                                                            "pattern": "^#(?:[A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$",
                                                            "default": ""
                                                        },
                                                        "control_id_hidden": {
                                                            "type": "string",
                                                            "default": ""
                                                        },
                                                        "max": {
                                                            "type": "integer",
                                                            "default": "12"
                                                        },
                                                        "min": {
                                                            "type": "integer",
                                                            "default": "-40"
                                                        },
                                                        "step": {
                                                            "type": "integer",
                                                            "default": "3"
                                                        }
                                                    }
                                                }
                                            },
                                            {
                                                "if": {
                                                    "properties": {
                                                        "widget_type": {
                                                            "const": "slider"
                                                        }
                                                    }
                                                },
                                                "then": {
                                                    "properties": {
                                                        "text": {
                                                            "type": "string",
                                                            "default": "text"
                                                        },
                                                        "control_id_active": {
                                                            "type": "string",
                                                            "default": ""
                                                        },
                                                        "control_id_hidden": {
                                                            "type": "string",
                                                            "default": ""
                                                        },
                                                        "max": {
                                                            "type": "integer",
                                                            "default": "12"
                                                        },
                                                        "min": {
                                                            "type": "integer",
                                                            "default": "-40"
                                                        },
                                                        "step": {
                                                            "type": "integer",
                                                            "default": "3"
                                                        }
                                                    }
                                                }
                                            },
                                            {
                                                "if": {
                                                    "properties": {
                                                        "widget_type": {
                                                            "const": "page"
                                                        }
                                                    }
                                                },
                                                "then": {
                                                    "properties": {
                                                        "page_id": {
                                                            "type": "string",
                                                            "default": "text"
                                                        }
                                                    }
                                                }
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "page_type": {
                                "const": "matrix"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "input_title": {
                                "type": "string",
                                "default": "Select Source"
                            },
                            "output_title": {
                                "type": "string",
                                "default": "Then Destination"
                            },
                            "input_columns": {
                                "type": "integer",
                                "default": 1
                            },
                            "output_columns": {
                                "type": "integer",
                                "default": 1
                            },
                            "inputs": {
                                "type": "array",
                                "properties": {
                                    "control_id": {
                                        "type": "string",
                                        "default": ""
                                    },
                                    "name": {
                                        "type": "string",
                                        "default": ""
                                    }
                                }
                            },
                            "outputs": {
                                "type": "array",
                                "properties": {
                                    "control_id": {
                                        "type": "string",
                                        "default": ""
                                    },
                                    "name": {
                                        "type": "string",
                                        "default": ""
                                    }
                                }
                            }
                        },
                        "required": ["port"]
                    }
                }
            ]
        }
    },
    "required": ["version"]
}
